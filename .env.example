# Self-Hosted Agentic Coding Platform

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here-change-in-production

# Next Auth Configuration
NEXTAUTH_URL=http://localhost:3000

# Database (self-hosted Postgres)
# Default: postgresql://postgres:postgres@localhost:5432/app
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/app

# Redis (for BullMQ queuing)
# Default: redis://localhost:6379
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub OAuth (for GitHub login and PR opening)
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=****
GITHUB_CLIENT_SECRET=****

# GitHub App (for opening PRs on behalf of the agent)
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=****
GITHUB_APP_PRIVATE_KEY=****
GITHUB_INSTALLATION_ID=****

# LLM API Keys (encrypted and stored per-user, but these can be defaults)
# ANTHROPIC_API_KEY=sk-ant-****
# OPENAI_API_KEY=sk-****

# Secrets Encryption (for storing user LLM keys at rest)
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=****

# OpenHands Integration (Phase 1)
OPENHANDS_API_URL=http://openhands:3001
OPENHANDS_LLM_API_KEY=sk-ant-****

# Supabase (local self-hosted)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics / Vercel
# Optional: AI_GATEWAY_API_KEY and VERCEL_ANALYTICS keys
NEXT_PUBLIC_BASE_PATH=/
